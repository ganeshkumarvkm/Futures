//@version=6
indicator("Trendline Strategy v1.0 — Top Down Map", overlay=true, max_lines_count=40, max_labels_count=200)

// Visual validation build. All HTF pivot data comes from completed HTF candles.
pivotBars = input.int(4, "Swing confirmation bars", minval=2, maxval=20)
minSwingAtr = input.float(0.6, "Minimum swing separation (HTF ATR)", minval=0, step=0.1)
touchAtr = input.float(0.15, "Touch tolerance (chart ATR)", minval=0.01, step=0.01)
breakAtr = input.float(0.25, "Break distance (chart ATR)", minval=0, step=0.05)
minTouchGap = input.int(5, "Bars between counted touches", minval=1)
showDaily = input.bool(true, "Daily lines", group="Timeframes")
show4H = input.bool(true, "4H lines", group="Timeframes")
show1H = input.bool(true, "1H lines", group="Timeframes")
show15M = input.bool(true, "15m lines", group="Timeframes")
showTable = input.bool(true, "Show top down dashboard", group="Display")
showReactions = input.bool(true, "Show reaction markers", group="Display")

f_pivots() =>
    pl = ta.pivotlow(low, pivotBars, pivotBars)
    ph = ta.pivothigh(high, pivotBars, pivotBars)
    lo1 = ta.valuewhen(not na(pl), pl, 0)
    lo2 = ta.valuewhen(not na(pl), pl, 1)
    lt1 = ta.valuewhen(not na(pl), time[pivotBars], 0)
    lt2 = ta.valuewhen(not na(pl), time[pivotBars], 1)
    hi1 = ta.valuewhen(not na(ph), ph, 0)
    hi2 = ta.valuewhen(not na(ph), ph, 1)
    ht1 = ta.valuewhen(not na(ph), time[pivotBars], 0)
    ht2 = ta.valuewhen(not na(ph), time[pivotBars], 1)
    [lo1[1], lo2[1], lt1[1], lt2[1], hi1[1], hi2[1], ht1[1], ht2[1], ta.atr(14)[1]]

[dL1,dL2,dLT1,dLT2,dH1,dH2,dHT1,dHT2,dATR] = request.security(syminfo.tickerid, "D", f_pivots(), lookahead=barmerge.lookahead_on)
[h4L1,h4L2,h4LT1,h4LT2,h4H1,h4H2,h4HT1,h4HT2,h4ATR] = request.security(syminfo.tickerid, "240", f_pivots(), lookahead=barmerge.lookahead_on)
[h1L1,h1L2,h1LT1,h1LT2,h1H1,h1H2,h1HT1,h1HT2,h1ATR] = request.security(syminfo.tickerid, "60", f_pivots(), lookahead=barmerge.lookahead_on)
[m15L1,m15L2,m15LT1,m15LT2,m15H1,m15H2,m15HT1,m15HT2,m15ATR] = request.security(syminfo.tickerid, "15", f_pivots(), lookahead=barmerge.lookahead_on)

f_level(float p1, float p2, int t1, int t2) =>
    not na(t1) and not na(t2) and t1 > t2 ? p1 + (p1-p2) * (time-t1) / (t1-t2) : na

f_map(bool enabled, string name, float lo1, float lo2, int lt1, int lt2, float hi1, float hi2, int ht1, int ht2, float swingAtr, color col, line support, line resistance) =>
    sLine = support
    rLine = resistance
    validLow = enabled and not na(lo1) and not na(lo2) and lo1 > lo2 and lo1-lo2 >= minSwingAtr*swingAtr
    validHigh = enabled and not na(hi1) and not na(hi2) and hi1 < hi2 and hi2-hi1 >= minSwingAtr*swingAtr
    if validLow and (na(sLine) or line.get_x2(sLine) != lt1)
        if not na(sLine)
            line.delete(sLine)
        sLine := line.new(lt2, lo2, lt1, lo1, xloc=xloc.bar_time, extend=extend.right, color=col, width=2)
    if not validLow and not na(sLine)
        line.delete(sLine)
        sLine := na
    if validHigh and (na(rLine) or line.get_x2(rLine) != ht1)
        if not na(rLine)
            line.delete(rLine)
        rLine := line.new(ht2, hi2, ht1, hi1, xloc=xloc.bar_time, extend=extend.right, color=col, width=2, style=line.style_dashed)
    if not validHigh and not na(rLine)
        line.delete(rLine)
        rLine := na
    s = validLow ? f_level(lo1, lo2, lt1, lt2) : na
    r = validHigh ? f_level(hi1, hi2, ht1, ht2) : na
    [sLine, rLine, s, r]

var line ds = na
var line dr = na
var line h4s = na
var line h4r = na
var line h1s = na
var line h1r = na
var line m15s = na
var line m15r = na
[dsNext, drNext, dS, dR] = f_map(showDaily,"D",dL1,dL2,dLT1,dLT2,dH1,dH2,dHT1,dHT2,dATR,color.purple,ds,dr)
[h4sNext, h4rNext, h4S, h4R] = f_map(show4H,"4H",h4L1,h4L2,h4LT1,h4LT2,h4H1,h4H2,h4HT1,h4HT2,h4ATR,color.orange,h4s,h4r)
[h1sNext, h1rNext, h1S, h1R] = f_map(show1H,"1H",h1L1,h1L2,h1LT1,h1LT2,h1H1,h1H2,h1HT1,h1HT2,h1ATR,color.aqua,h1s,h1r)
[m15sNext, m15rNext, m15S, m15R] = f_map(show15M,"15m",m15L1,m15L2,m15LT1,m15LT2,m15H1,m15H2,m15HT1,m15HT2,m15ATR,color.gray,m15s,m15r)
ds := dsNext
dr := drNext
h4s := h4sNext
h4r := h4rNext
h1s := h1sNext
h1r := h1rNext
m15s := m15sNext
m15r := m15rNext

atr = ta.atr(14)
f_react(float s, float r) =>
    up = not na(s) and low <= s + touchAtr*atr and low >= s - breakAtr*atr and close > s and close > open
    down = not na(r) and high >= r - touchAtr*atr and high <= r + breakAtr*atr and close < r and close < open
    brokenS = not na(s) and close < s-breakAtr*atr and close[1] >= s[1]-breakAtr*atr[1]
    brokenR = not na(r) and close > r+breakAtr*atr and close[1] <= r[1]+breakAtr*atr[1]
    [up,down,brokenS,brokenR]
[dUp,dDn,dBS,dBR] = f_react(dS,dR)
[h4Up,h4Dn,h4BS,h4BR] = f_react(h4S,h4R)
[h1Up,h1Dn,h1BS,h1BR] = f_react(h1S,h1R)
[m15Up,m15Dn,m15BS,m15BR] = f_react(m15S,m15R)

// Count distinct reaction clusters; one move along a line cannot inflate its touch count on every candle.
var int[] touchesUp = array.new_int(4, 0)
var int[] touchesDown = array.new_int(4, 0)
var int[] lastUp = array.new_int(4, -100000)
var int[] lastDown = array.new_int(4, -100000)
var int[] seenLow = array.new_int(4, 0)
var int[] seenHigh = array.new_int(4, 0)
f_count(int index, int lowTime, int highTime, bool up, bool down) =>
    if not na(lowTime) and array.get(seenLow,index) != lowTime
        array.set(seenLow,index,lowTime)
        array.set(touchesUp,index,0)
    if not na(highTime) and array.get(seenHigh,index) != highTime
        array.set(seenHigh,index,highTime)
        array.set(touchesDown,index,0)
    if up and bar_index-array.get(lastUp,index) >= minTouchGap
        array.set(touchesUp,index,array.get(touchesUp,index)+1)
        array.set(lastUp,index,bar_index)
    if down and bar_index-array.get(lastDown,index) >= minTouchGap
        array.set(touchesDown,index,array.get(touchesDown,index)+1)
        array.set(lastDown,index,bar_index)

if barstate.isconfirmed
    f_count(0,dLT1,dHT1,dUp,dDn)
    f_count(1,h4LT1,h4HT1,h4Up,h4Dn)
    f_count(2,h1LT1,h1HT1,h1Up,h1Dn)
    f_count(3,m15LT1,m15HT1,m15Up,m15Dn)

// HTF directional context is displayed, never used to create trades in this visual version.
dBias = not na(dS) and close >= dS ? 1 : not na(dR) and close <= dR ? -1 : 0
h4Bias = not na(h4S) and close >= h4S ? 1 : not na(h4R) and close <= h4R ? -1 : 0
alignedUp = dBias == 1 and h4Bias == 1
alignedDown = dBias == -1 and h4Bias == -1
rawUp = dUp or h4Up or h1Up or m15Up
rawDown = dDn or h4Dn or h1Dn or m15Dn
plotshape(showReactions and barstate.isconfirmed and rawUp, "Support rejection", shape.triangleup, location.belowbar, color.lime, size=size.tiny, text="R")
plotshape(showReactions and barstate.isconfirmed and rawDown, "Resistance rejection", shape.triangledown, location.abovebar, color.red, size=size.tiny, text="R")
plotshape(showReactions and barstate.isconfirmed and (dBS or h4BS or h1BS or m15BS), "Support break", shape.xcross, location.abovebar, color.orange, size=size.tiny)
plotshape(showReactions and barstate.isconfirmed and (dBR or h4BR or h1BR or m15BR), "Resistance break", shape.xcross, location.belowbar, color.orange, size=size.tiny)

f_status(float s, float r, int upCount, int downCount) =>
    na(s) and na(r) ? "No qualified line" : "S " + (na(s) ? "—" : str.tostring(s,format.mintick) + " (" + str.tostring(upCount) + ")") + "  R " + (na(r) ? "—" : str.tostring(r,format.mintick) + " (" + str.tostring(downCount) + ")")
var table dash = table.new(position.top_right,2,6,border_width=1)
if barstate.islast and showTable
    table.cell(dash,0,0,"Top down",text_color=color.white,bgcolor=color.black)
    table.cell(dash,1,0,alignedUp ? "D + 4H above support" : alignedDown ? "D + 4H below resistance" : "Mixed / incomplete",text_color=color.white,bgcolor=alignedUp ? color.green : alignedDown ? color.maroon : color.gray)
    table.cell(dash,0,1,"Daily",text_color=color.purple,bgcolor=color.black)
    table.cell(dash,1,1,f_status(dS,dR,array.get(touchesUp,0),array.get(touchesDown,0)))
    table.cell(dash,0,2,"4H",text_color=color.orange,bgcolor=color.black)
    table.cell(dash,1,2,f_status(h4S,h4R,array.get(touchesUp,1),array.get(touchesDown,1)))
    table.cell(dash,0,3,"1H",text_color=color.aqua,bgcolor=color.black)
    table.cell(dash,1,3,f_status(h1S,h1R,array.get(touchesUp,2),array.get(touchesDown,2)))
    table.cell(dash,0,4,"15m",text_color=color.silver,bgcolor=color.black)
    table.cell(dash,1,4,f_status(m15S,m15R,array.get(touchesUp,3),array.get(touchesDown,3)))
    table.cell(dash,0,5,"Current",text_color=color.white,bgcolor=color.black)
    table.cell(dash,1,5,rawUp ? "Support reaction" : rawDown ? "Resistance reaction" : "Waiting",text_color=color.white,bgcolor=color.black)

alertcondition(barstate.isconfirmed and rawUp, "Trendline support reaction", "Confirmed support reaction on {{ticker}} {{interval}}")
alertcondition(barstate.isconfirmed and rawDown, "Trendline resistance reaction", "Confirmed resistance reaction on {{ticker}} {{interval}}")
